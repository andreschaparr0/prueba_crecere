    {
      "start": 164.2,
      "end": 167.04,
      "speaker": "SPEAKER_01",
      "text": "Ya pagar lo que tú me estás diciendo ya es otra cosa.",
      "rol": "DEUDOR"
    },
    {
      "start": 167.64,
      "end": 169.22,
      "speaker": "SPEAKER_01",
      "text": "Entonces no puedo ya acudir contigo.",
      "rol": "DEUDOR"
    },
    {
      "start": 171.72,
      "end": 175.68,
      "speaker": "SPEAKER_00",
      "text": "Como le indico, quizás hicieron un acuerdo por una sola obligación.",
      "rol": "AGENTE"
    },
    {
      "start": 176.36,
      "end": 178.42,
      "speaker": "SPEAKER_00",
      "text": "Porque usted tiene dos obligaciones con nosotros.",
      "rol": "AGENTE"
    },
    {
      "start": 178.42,
      "end": 179.24,
      "speaker": "SPEAKER_00",
      "text": "No, negativo, por las dos obligaciones.",
      "rol": "AGENTE"
    },
    {
      "start": 182.82,
      "end": 183.3,
      "speaker": "SPEAKER_00",
      "text": "Entendemos.",
      "rol": "AGENTE"
    },
    {
      "start": 184.28,
      "end": 186.04,
      "speaker": "SPEAKER_00",
      "text": "Pero como le indico, o sea, el máximo...",
      "rol": "AGENTE"
    }

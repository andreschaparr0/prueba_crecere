      "start": 106.28,
      "end": 108.7,
      "speaker": "SPEAKER_00",
      "text": "que actualmente tiene su ubicación",
      "rol": "AGENTE"
    },
    {
      "start": 108.7,
      "end": 109.84,
      "speaker": "SPEAKER_00",
      "text": "somos todos un",
      "rol": "AGENTE"
    },
    {
      "start": 109.84,
      "end": 113.1,
      "speaker": "SPEAKER_01",
      "text": "un pacifista",
      "rol": "DEUDOR"
    },
    {
      "start": 113.1,
      "end": 115.1,
      "speaker": "SPEAKER_01",
      "text": "me llamó alguien de ustedes",
      "rol": "DEUDOR"

      "text": "y me propuso pagar",
      "rol": "DEUDOR"
    },
    {
      "start": 96.11,
      "end": 97.65,
      "speaker": "SPEAKER_01",
      "text": "8 millones de pesos en cuotas",
      "rol": "DEUDOR"
    },
    {
      "start": 97.65,
      "end": 99.81,
      "speaker": "SPEAKER_01",
      "text": "en 10 cuotas",
      "rol": "DEUDOR"
    },
    {
      "start": 99.81,
      "end": 101.31,
      "speaker": "SPEAKER_01",
      "text": "entonces estamos ahí aguardando",
      "rol": "DEUDOR"
    },
    {
      "start": 101.31,
      "end": 102.87,
      "speaker": "SPEAKER_00",
      "text": "pero",
      "rol": "AGENTE"
    },

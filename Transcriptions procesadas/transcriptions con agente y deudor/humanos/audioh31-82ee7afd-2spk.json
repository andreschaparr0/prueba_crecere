      "speaker": "SPEAKER_01",
      "text": "comprendemos",
      "rol": "DEUDOR"
    },
    {
      "start": 117.06,
      "end": 118.76,
      "speaker": "SPEAKER_01",
      "text": "estoy esperando la llamada",
      "rol": "DEUDOR"

  "n_speakers_detected": 2,
  "segments": [
    {
      "start": 11.63,
      "end": 15.85,
      "speaker": "SPEAKER_00",
      "text": "Buenos días, tengo el gusto de hablar con el señor Enrique Vizcaíl.",
      "rol": "AGENTE"
    },
    {
      "start": 17.31,
      "end": 18.57,
      "speaker": "SPEAKER_01",
      "text": "Hablo con quien tengo el gusto.",
      "rol": "DEUDOR"
    },
    {
      "start": 19.21,
      "end": 20.65,
      "speaker": "SPEAKER_00",
      "text": "Habla con el señor Soto.",
      "rol": "AGENTE"
    },
    {
      "start": 22.42,
      "end": 29.4,
      "speaker": "SPEAKER_00",
      "text": "Nosotros somos quienes contamos la cartera de su obligación con el señor Soto, como se encuentra el día de hoy.",
      "rol": "AGENTE"
    },
    {
      "start": 31.18,
      "end": 32.88,
      "speaker": "SPEAKER_01",
      "text": "Bien, gracias, adiós.",
      "rol": "DEUDOR"
    },
    {
      "start": 33.42,
      "end": 41.97,
      "speaker": "SPEAKER_00",
      "text": "Me comunico para informarle que a la fecha registra un saldo total de sus dos obligaciones",
      "rol": "AGENTE"
    },
    {
      "start": 41.97,
      "end": 48.1,
      "speaker": "SPEAKER_00",
      "text": "por $19,620,732.",
      "rol": "AGENTE"
    },
    {
      "start": 49.04,
      "end": 53.86,
      "speaker": "SPEAKER_00",
      "text": "El día de hoy estamos manejando una campaña para que usted quede al día con sus obligaciones",
      "rol": "AGENTE"
    },
    {
      "start": 53.86,
      "end": 56.0,
      "speaker": "SPEAKER_00",
      "text": "y es pedir un pasisargo.",
      "rol": "AGENTE"
    },
    {
      "start": 57.8,
      "end": 61.66,
      "speaker": "SPEAKER_00",
      "text": "Estamos manejando un 20% de descuento sobre el valor de sus obligaciones,",
      "rol": "AGENTE"
    },
    {
      "start": 61.66,
      "end": 63.52,
      "speaker": "SPEAKER_00",
      "text": "obligaciones, o sea que sus obligaciones",
      "rol": "AGENTE"
    },
    {
      "start": 63.52,
      "end": 65.48,
      "speaker": "SPEAKER_00",
      "text": "estarían el día de hoy con el descuento",
      "rol": "AGENTE"
    },
    {
      "start": 65.48,
      "end": 67.44,
      "speaker": "SPEAKER_00",
      "text": "en un valor de 15 millones",
      "rol": "AGENTE"
    },
    {
      "start": 67.44,
      "end": 69.48,
      "speaker": "SPEAKER_00",
      "text": "697 mil",
      "rol": "AGENTE"
    },
    {
      "start": 69.48,
      "end": 71.58,
      "speaker": "SPEAKER_00",
      "text": "pesos. Este valor lo puede pagar",
      "rol": "AGENTE"
    },
    {
      "start": 71.58,
      "end": 73.38,
      "speaker": "SPEAKER_00",
      "text": "hasta en tres cuotas. ¿Usted está",
      "rol": "AGENTE"
    },
    {
      "start": 73.38,
      "end": 75.38,
      "speaker": "SPEAKER_00",
      "text": "interesado en aplicar a este descuento?",
      "rol": "AGENTE"
    },
    {
      "start": 77.17,
      "end": 78.23,
      "speaker": "SPEAKER_01",
      "text": "No, la verdad no,",
      "rol": "DEUDOR"
    },
    {
      "start": 78.33,
      "end": 79.95,
      "speaker": "SPEAKER_01",
      "text": "porque ya me hicieron una propuesta mejor.",
      "rol": "DEUDOR"
    },
    {
      "start": 81.62,
      "end": 82.18,
      "speaker": "SPEAKER_00",
      "text": "Comprendo.",
      "rol": "AGENTE"
    },
    {
      "start": 82.5,
      "end": 84.3,
      "speaker": "SPEAKER_00",
      "text": "¿Qué propuesta le hicieron y",
      "rol": "AGENTE"
    },
    {
      "start": 84.3,
      "end": 85.58,
      "speaker": "SPEAKER_00",
      "text": "quién lo llamó?",
      "rol": "AGENTE"
    },
    {
      "start": 86.73,
      "end": 88.95,
      "speaker": "SPEAKER_01",
      "text": "Me llamó una empresa",
      "rol": "DEUDOR"
    },
    {
      "start": 88.95,
      "end": 90.09,
      "speaker": "SPEAKER_01",
      "text": "que se llama",
      "rol": "DEUDOR"
    },
    {
      "start": 90.09,
      "end": 91.55,
      "speaker": "SPEAKER_01",
      "text": "también",
      "rol": "DEUDOR"
    },
    {
      "start": 91.55,
      "end": 93.31,
      "speaker": "SPEAKER_01",
      "text": "de relato, algo así",
      "rol": "DEUDOR"
    },
    {
      "start": 93.31,

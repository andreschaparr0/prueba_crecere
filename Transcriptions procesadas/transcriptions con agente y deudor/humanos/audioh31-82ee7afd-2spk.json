      "speaker": "SPEAKER_00",
      "text": "Comprendemos",
      "rol": "AGENTE"
    },
    {
      "start": 150.34,
      "end": 154.02,
      "speaker": "SPEAKER_00",
      "text": "Porque también podemos llegar a un acuerdo de largo plazo",
      "rol": "AGENTE"
    },
    {
      "start": 154.02,
      "end": 157.34,
      "speaker": "SPEAKER_00",
      "text": "donde usted va a pagar la totalidad de sus obligaciones.",
      "rol": "AGENTE"
    },
    {
      "start": 158.28,
      "end": 162.18,
      "speaker": "SPEAKER_01",
      "text": "No, no, vuelvo y te repito, ya yo quedé con un acuerdo con él,",
      "rol": "DEUDOR"
    },
    {
      "start": 162.3,
      "end": 163.46,
      "speaker": "SPEAKER_01",
      "text": "entonces esperemos que él me llame.",
      "rol": "DEUDOR"

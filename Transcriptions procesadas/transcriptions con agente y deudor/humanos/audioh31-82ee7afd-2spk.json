    {
      "start": 139.16,
      "end": 139.76,
      "speaker": "SPEAKER_00",
      "text": "No, no, no",
      "rol": "AGENTE"
    },
    {
      "start": 139.76,
      "end": 143.5,
      "speaker": "SPEAKER_01",
      "text": "Yo hablé otra cosa con un compañero de usted",
      "rol": "DEUDOR"
    },
    {
      "start": 143.5,
      "end": 145.16,
      "speaker": "SPEAKER_01",
      "text": "Pero cuando él me llame",
      "rol": "DEUDOR"
    },
    {
      "start": 145.16,
      "end": 147.5,
      "speaker": "SPEAKER_01",
      "text": "Él quedó en llamarme esta semana",
      "rol": "DEUDOR"
    },
    {
      "start": 147.5,
      "end": 148.6,
      "speaker": "SPEAKER_01",
      "text": "No te preocupes",
      "rol": "DEUDOR"

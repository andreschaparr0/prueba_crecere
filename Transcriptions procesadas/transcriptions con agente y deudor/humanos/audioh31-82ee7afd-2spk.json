    {
      "start": 118.76,
      "end": 120.18,
      "speaker": "SPEAKER_01",
      "text": "para confirmar",
      "rol": "DEUDOR"
    },
    {
      "start": 120.18,
      "end": 123.76,
      "speaker": "SPEAKER_00",
      "text": "Entiendo, pero es que usted tiene dos obligaciones con nosotros",
      "rol": "AGENTE"
    },
    {
      "start": 123.76,
      "end": 126.7,
      "speaker": "SPEAKER_01",
      "text": "Yo sé que tengo dos obligaciones",
      "rol": "DEUDOR"
    },
    {
      "start": 126.7,
      "end": 128.48,
      "speaker": "SPEAKER_01",
      "text": "Y por eso una sola cartera",
      "rol": "DEUDOR"
    },
    {
      "start": 128.48,
      "end": 130.2,
      "speaker": "SPEAKER_01",
      "text": "Yo hablé todo eso con él",
      "rol": "DEUDOR"
    },
    {
      "start": 130.2,
      "end": 132.94,
      "speaker": "SPEAKER_00",
      "text": "Comprendemos",
      "rol": "AGENTE"
    },
    {
      "start": 132.94,
      "end": 134.52,
      "speaker": "SPEAKER_00",
      "text": "Pero como le indico",
      "rol": "AGENTE"
    },
    {
      "start": 134.52,
      "end": 136.9,
      "speaker": "SPEAKER_00",
      "text": "El máximo descuento autorizado",
      "rol": "AGENTE"
    },
    {
      "start": 136.9,
      "end": 139.16,
      "speaker": "SPEAKER_00",
      "text": "Es el 20% de descuento sobre el valor",
      "rol": "AGENTE"

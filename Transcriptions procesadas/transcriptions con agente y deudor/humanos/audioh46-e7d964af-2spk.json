  "segments": [
    {
      "start": 11.44,
      "end": 16.31,
      "speaker": "SPEAKER_01",
      "text": "Muy buenos días señora Ingrid",
      "rol": "AGENTE"
    },
    {
      "start": 16.31,
      "end": 18.4,
      "speaker": "SPEAKER_01",
      "text": "Muy buenos días",
      "rol": "AGENTE"
    },
    {
      "start": 18.4,
      "end": 21.96,
      "speaker": "SPEAKER_01",
      "text": "Hablas con el asesor de Solucionar Cook",
      "rol": "AGENTE"
    },
    {
      "start": 21.96,
      "end": 22.42,
      "speaker": "SPEAKER_01",
      "text": "¿Cómo está?",
      "rol": "AGENTE"
    },
    {
      "start": 24.38,
      "end": 24.9,
      "speaker": "SPEAKER_01",
      "text": "¿De qué?",
      "rol": "AGENTE"
    },
    {
      "start": 25.92,
      "end": 26.88,
      "speaker": "SPEAKER_01",
      "text": "Hablas con el asesor",
      "rol": "AGENTE"
    },
    {
      "start": 26.88,
      "end": 32.89,
      "speaker": "SPEAKER_01",
      "text": "Sí, dígame",
      "rol": "AGENTE"
    },
    {
      "start": 32.89,
      "end": 36.83,
      "speaker": "SPEAKER_01",
      "text": "Es que me comunico con usted porque usted tiene una cartera pendiente",
      "rol": "AGENTE"
    },
    {
      "start": 36.83,
      "end": 39.32,
      "speaker": "SPEAKER_01",
      "text": "Es para ofrecerle un descuento",
      "rol": "AGENTE"
    },
    {
      "start": 39.32,
      "end": 41.4,
      "speaker": "SPEAKER_01",
      "text": "De pronto, ¿ya se han comunicado con usted?",
      "rol": "AGENTE"
    },
    {
      "start": 42.72,
      "end": 43.3,
      "speaker": "SPEAKER_01",
      "text": "Sí, ya",
      "rol": "AGENTE"
    },
    {
      "start": 43.3,
      "end": 44.78,
      "speaker": "SPEAKER_01",
      "text": "Yo había hablado con usted",
      "rol": "AGENTE"
    },
    {
      "start": 44.78,
      "end": 47.8,
      "speaker": "SPEAKER_01",
      "text": "¿Y ha realizado algún acuerdo de pago?",
      "rol": "AGENTE"
    },
    {
      "start": 47.8,
      "end": 49.44,
      "speaker": "SPEAKER_01",
      "text": "Porque no me registra ninguno",
      "rol": "AGENTE"
    },
    {
      "start": 49.44,
      "end": 51.82,
      "speaker": "SPEAKER_01",
      "text": "No, no, porque si ustedes quieren",
      "rol": "AGENTE"
    },
    {
      "start": 51.82,
      "end": 53.24,
      "speaker": "SPEAKER_01",
      "text": "Que yo les dé una sola cuota",
      "rol": "AGENTE"
    },
    {
      "start": 53.24,
      "end": 55.78,
      "speaker": "SPEAKER_01",
      "text": "De no sé cuántos millones, 18 millones de pesos",
      "rol": "AGENTE"
    },
    {
      "start": 55.78,
      "end": 58.18,
      "speaker": "SPEAKER_01",
      "text": "¿Y dónde tengo yo para darles 18 millones de pesos",
      "rol": "AGENTE"
    },
    {
      "start": 58.18,
      "end": 59.02,
      "speaker": "SPEAKER_01",
      "text": "A una sola cuota?",
      "rol": "AGENTE"
    },
    {
      "start": 60.5,
      "end": 62.32,
      "speaker": "SPEAKER_01",
      "text": "Entiendo, no tienen toda la capacidad",
      "rol": "AGENTE"
    },
    {
      "start": 62.32,
      "end": 64.32,
      "speaker": "SPEAKER_01",
      "text": "¿Y no les gustaría de pronto que yo les ofrezca",
      "rol": "AGENTE"
    },
    {
      "start": 64.32,
      "end": 66.02,
      "speaker": "SPEAKER_01",
      "text": "Un descuento total y",
      "rol": "AGENTE"
    },
    {
      "start": 66.02,
      "end": 68.04,
      "speaker": "SPEAKER_01",
      "text": "Que le damos un acuerdo de pago así sea cuotas?",
      "rol": "AGENTE"
    },
    {
      "start": 69.92,
      "end": 71.5,
      "speaker": "SPEAKER_01",
      "text": "Sí, es que yo le dije a ellos",
      "rol": "AGENTE"
    },
    {
      "start": 71.5,
      "end": 72.96,
      "speaker": "SPEAKER_01",
      "text": "Que yo me iba a acercar a la oficina",
      "rol": "AGENTE"
    },
    {
      "start": 72.96,
      "end": 74.4,
      "speaker": "SPEAKER_01",
      "text": "Ya de...",
      "rol": "AGENTE"
    },
    {
      "start": 74.4,
      "end": 77.68,
      "speaker": "SPEAKER_01",
      "text": "Pues te explico",
      "rol": "AGENTE"
    },
    {
      "start": 77.68,
      "end": 79.96,
      "speaker": "SPEAKER_01",
      "text": "Lo que pasa es que la cartera suya",
      "rol": "AGENTE"
    },
    {
      "start": 79.96,
      "end": 82.08,
      "speaker": "SPEAKER_01",
      "text": "ya fue vendida. La cartera",
      "rol": "AGENTE"
    },
    {
      "start": 82.08,
      "end": 83.3,
      "speaker": "SPEAKER_01",
      "text": "ahora pertenece a",
      "rol": "AGENTE"
    },
    {
      "start": 83.3,
      "end": 85.94,
      "speaker": "SPEAKER_01",
      "text": "Solución Acup. Entonces,",
      "rol": "AGENTE"
    },
    {
      "start": 86.06,
      "end": 87.64,
      "speaker": "SPEAKER_01",
      "text": "por eso nos estamos comunicando con usted",
      "rol": "AGENTE"
    },
    {
      "start": 87.64,
      "end": 90.1,
      "speaker": "SPEAKER_01",
      "text": "para que logremos un acuerdo de pago.",
      "rol": "AGENTE"
    },
    {
      "start": 91.08,
      "end": 92.04,
      "speaker": "SPEAKER_01",
      "text": "Pues actualmente",
      "rol": "AGENTE"
    },
    {
      "start": 92.04,
      "end": 93.82,
      "speaker": "SPEAKER_01",
      "text": "la deuda de sus tres obligaciones",
      "rol": "AGENTE"
    },
    {
      "start": 93.82,
      "end": 96.0,
      "speaker": "SPEAKER_01",
      "text": "que están pendientes está por 16 millones",
      "rol": "AGENTE"
    },
    {
      "start": 96.0,
      "end": 97.88,
      "speaker": "SPEAKER_01",
      "text": "de pesos. Pero usted me dice",
      "rol": "AGENTE"
    },
    {
      "start": 97.88,
      "end": 99.58,
      "speaker": "SPEAKER_01",
      "text": "que usted no puede pagar todo eso de una.",
      "rol": "AGENTE"
    },
    {
      "start": 100.66,
      "end": 101.98,
      "speaker": "SPEAKER_01",
      "text": "Lo que podemos hacer",
      "rol": "AGENTE"
    },
    {
      "start": 101.98,
      "end": 102.7,
      "speaker": "SPEAKER_01",
      "text": "es lo siguiente.",
      "rol": "AGENTE"
    },
    {
      "start": 103.7,
      "end": 105.84,
      "speaker": "SPEAKER_01",
      "text": "Esos 16 millones de pesos le podemos brindar",
      "rol": "AGENTE"
    },
    {
      "start": 105.84,
      "end": 106.58,
      "speaker": "SPEAKER_01",
      "text": "un descuento,",
      "rol": "AGENTE"
    },
    {
      "start": 107.14,
      "end": 109.36,
      "speaker": "SPEAKER_01",
      "text": "un 30% de descuento",
      "rol": "AGENTE"
    },
    {
      "start": 109.36,
      "end": 111.9,
      "speaker": "SPEAKER_01",
      "text": "para que cancele 11 millones de pesos",
      "rol": "AGENTE"
    },
    {
      "start": 111.9,
      "end": 114.42,
      "speaker": "SPEAKER_01",
      "text": "y podríamos manejarlo a cuotas",
      "rol": "AGENTE"
    },
    {
      "start": 114.42,
      "end": 115.0,
      "speaker": "SPEAKER_01",
      "text": "¿qué le parece?",
      "rol": "AGENTE"
    },
    {
      "start": 121.61,
      "end": 122.39,
      "speaker": "SPEAKER_01",
      "text": "¿me escucha?",
      "rol": "AGENTE"
    },
    {
      "start": 125.71,
      "end": 126.35,
      "speaker": "UNKNOWN",
      "text": "aló",
      "rol": "UNKNOWN"
    }

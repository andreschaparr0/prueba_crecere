      "rol": "AGENTE"
    },
    {
      "start": 27.9,
      "end": 28.72,
      "speaker": "SPEAKER_01",
      "text": "¿Cómo está?",
      "rol": "AGENTE"
    },
    {
      "start": 30.54,
      "end": 31.88,
      "speaker": "SPEAKER_00",
      "text": "Bien, gracias a Dios.",
      "rol": "DEUDOR"
    },
    {
      "start": 32.1,
      "end": 34.24,
      "speaker": "SPEAKER_00",
      "text": "Hija, no sé si me puede llamar más tarde.",
      "rol": "DEUDOR"
    },
    {
      "start": 34.34,
      "end": 35.3,
      "speaker": "SPEAKER_00",
      "text": "Ahorita estoy ocupado.",
      "rol": "DEUDOR"
    },
    {
      "start": 36.34,
      "end": 36.7,
      "speaker": "SPEAKER_01",
      "text": "Perfecto.",
      "rol": "AGENTE"
    },
    {
      "start": 36.72,
      "end": 38.48,
      "speaker": "SPEAKER_01",
      "text": "De igual manera, le voy a dejar una notificación vía WhatsApp",
      "rol": "AGENTE"
    },
    {
      "start": 38.48,
      "end": 41.24,
      "speaker": "SPEAKER_01",

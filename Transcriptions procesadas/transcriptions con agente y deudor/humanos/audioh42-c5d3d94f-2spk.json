      "rol": "AGENTE"
    },
    {
      "start": 42.68,
      "end": 44.66,
      "speaker": "SPEAKER_00",
      "text": "Bueno, de hecho, no sé si la envío dentro de un ratito.",
      "rol": "DEUDOR"
    },
    {
      "start": 44.78,
      "end": 46.64,
      "speaker": "SPEAKER_00",
      "text": "Estoy instalando el WhatsApp en otro dispositivo.",
      "rol": "DEUDOR"
    },
    {
      "start": 48.43,
      "end": 49.49,
      "speaker": "SPEAKER_01",
      "text": "Perfecto, listo, sí, señor.",
      "rol": "AGENTE"
    },
    {
      "start": 49.49,
      "end": 51.23,
      "speaker": "SPEAKER_00",
      "text": "Deje nomás llegar la información y se me borra",
      "rol": "DEUDOR"
    },
    {
      "start": 51.23,
      "end": 52.53,
      "speaker": "SPEAKER_00",
      "text": "Del dispositivo viejo",
      "rol": "DEUDOR"
    },
    {
      "start": 52.53,
      "end": 54.71,
      "speaker": "SPEAKER_01",
      "text": "Bueno, listo, sí señor",
      "rol": "AGENTE"
    },
    {
      "start": 54.71,
      "end": 56.51,
      "speaker": "SPEAKER_01",
      "text": "Tú te salen dentro de un rato",
      "rol": "AGENTE"
    },
    {
      "start": 56.51,
      "end": 58.5,
      "speaker": "SPEAKER_00",
      "text": "Vale, vale",
      "rol": "DEUDOR"
    },
    {
      "start": 58.5,
      "end": 59.8,
      "speaker": "SPEAKER_01",
      "text": "Bueno, hasta luego",
      "rol": "AGENTE"
    },
    {
      "start": 59.8,

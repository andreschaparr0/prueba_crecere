{
  "file_id": "635a7986-ddd2-47f3-a6de-82a217053afa",
  "source": "humano",
  "duration_sec": 166.74,
  "language": "es",
  "n_speakers_detected": 1,
  "segments": [
    {
      "start": 14.29,
      "end": 14.89,
      "speaker": "SPEAKER_01",
      "text": "Hola, buenos días.",
      "rol": "AGENTE"
    },
    {
      "start": 15.57,
      "end": 17.11,
      "speaker": "SPEAKER_01",
      "text": "Buenos días, tengo el gusto de hablar con usted.",
      "rol": "AGENTE"
    },
    {
      "start": 20.0,
      "end": 20.94,
      "speaker": "SPEAKER_01",
      "text": "Sí, señorita.",
      "rol": "DEUDOR"
    },
    {
      "start": 22.06,
      "end": 23.54,
      "speaker": "SPEAKER_01",
      "text": "Mucho gusto, habla con usted.",
      "rol": "AGENTE"
    },
    {
      "start": 23.98,
      "end": 30.28,
      "speaker": "SPEAKER_01",
      "text": "Soy López Patricio y nos comunicamos referente a su obligación, compadre, como se encuentra el día de hoy.",
      "rol": "AGENTE"
    },
    {
      "start": 30.8,
      "end": 31.72,
      "speaker": "SPEAKER_01",
      "text": "Sí, señorita.",
      "rol": "DEUDOR"
    },
    {
      "start": 33.49,
      "end": 42.47,
      "speaker": "SPEAKER_01",
      "text": "Estamos validando nuestro sistema y no hemos reflejado su pago según acuerdo de pago para el día 3 de agosto por 1.270.000 pesos.",
      "rol": "AGENTE"
    },
    {
      "start": 43.03,
      "end": 45.57,
      "speaker": "SPEAKER_01",
      "text": "Quisiéramos validar porque no se realizó este pago.",
      "rol": "AGENTE"
    },
    {
      "start": 45.57,
      "end": 48.39,
      "speaker": "SPEAKER_01",
      "text": "No, es que no",
      "rol": "DEUDOR"
    },
    {
      "start": 48.39,
      "end": 50.71,
      "speaker": "SPEAKER_01",
      "text": "no alcance a reunir todo el dinero",
      "rol": "DEUDOR"
    },
    {
      "start": 50.71,
      "end": 53.1,
      "speaker": "SPEAKER_01",
      "text": "Comprendemos",
      "rol": "AGENTE"
    },
    {
      "start": 53.1,
      "end": 56.29,
      "speaker": "SPEAKER_01",
      "text": "¿Y para cuándo podría revisar el pago",
      "rol": "AGENTE"
    },
    {
      "start": 56.29,
      "end": 57.95,
      "speaker": "SPEAKER_01",
      "text": "para dar cumplimiento al acuerdo?",
      "rol": "AGENTE"
    },
    {
      "start": 58.87,
      "end": 59.85,
      "speaker": "SPEAKER_01",
      "text": "Yo creo que por ahí",
      "rol": "DEUDOR"
    },
    {
      "start": 59.85,
      "end": 61.05,
      "speaker": "SPEAKER_01",
      "text": "en fin de mes",
      "rol": "DEUDOR"
    },
    {
      "start": 61.05,
      "end": 64.51,
      "speaker": "SPEAKER_01",
      "text": "Entiendo",
      "rol": "AGENTE"
    },
    {
      "start": 64.51,
      "end": 66.68,
      "speaker": "SPEAKER_01",
      "text": "¿Y cuánto tiene reunido?",
      "rol": "AGENTE"
    },
    {
      "start": 66.78,
      "end": 68.12,
      "speaker": "SPEAKER_01",
      "text": "Porque puede hacer un abono",
      "rol": "AGENTE"
    },
    {
      "start": 68.12,
      "end": 70.18,
      "speaker": "SPEAKER_01",
      "text": "ahorita el 15 de agosto",
      "rol": "AGENTE"
    },
    {
      "start": 70.18,
      "end": 71.9,
      "speaker": "SPEAKER_01",
      "text": "y el restante a final de mes",
      "rol": "AGENTE"
    },
    {
      "start": 71.9,
      "end": 74.36,
      "speaker": "SPEAKER_01",
      "text": "para que no se pase el mes y no dar cumplimiento",
      "rol": "AGENTE"
    },
    {
      "start": 74.36,
      "end": 76.2,
      "speaker": "SPEAKER_01",
      "text": "al acuerdo y que nos caiga el acuerdo de pago",
      "rol": "AGENTE"
    },
    {
      "start": 76.2,
      "end": 79.3,
      "speaker": "SPEAKER_01",
      "text": "Ahorita no tengo",
      "rol": "DEUDOR"
    },
    {
      "start": 79.3,
      "end": 81.34,
      "speaker": "SPEAKER_01",
      "text": "No tengo nada",
      "rol": "DEUDOR"
    },
    {
      "start": 81.34,
      "end": 82.16,
      "speaker": "SPEAKER_01",
      "text": "La verdad no tengo nada",
      "rol": "DEUDOR"
    },
    {
      "start": 82.16,
      "end": 84.14,
      "speaker": "SPEAKER_01",
      "text": "Entonces estaba esperando a fin de mes",
      "rol": "DEUDOR"
    },
    {
      "start": 84.14,
      "end": 87.44,
      "speaker": "SPEAKER_01",
      "text": "Porque tengo un problema también",
      "rol": "DEUDOR"
    },
    {
      "start": 87.44,
      "end": 88.56,
      "speaker": "SPEAKER_01",
      "text": "Y entonces",
      "rol": "DEUDOR"
    },
    {
      "start": 88.56,
      "end": 93.79,
      "speaker": "SPEAKER_01",
      "text": "Me tocó pagar un",
      "rol": "DEUDOR"
    },
    {
      "start": 93.79,
      "end": 96.09,
      "speaker": "SPEAKER_01",
      "text": "Un accidente que cometió el perro mío",
      "rol": "DEUDOR"
    },
    {
      "start": 96.09,
      "end": 96.49,
      "speaker": "SPEAKER_01",
      "text": "Entonces",
      "rol": "DEUDOR"
    },
    {
      "start": 96.49,
      "end": 99.64,
      "speaker": "SPEAKER_01",
      "text": "Ahí me descuadré",
      "rol": "DEUDOR"
    },
    {
      "start": 99.64,
      "end": 101.82,
      "speaker": "SPEAKER_01",
      "text": "Entendemos la situación",
      "rol": "AGENTE"
    },
    {
      "start": 101.82,
      "end": 105.3,
      "speaker": "SPEAKER_01",
      "text": "Pero seguro se cancela para el día",
      "rol": "AGENTE"
    },
    {
      "start": 105.3,
      "end": 107.06,
      "speaker": "SPEAKER_01",
      "text": "30 de agosto",
      "rol": "AGENTE"
    },
    {
      "start": 107.06,
      "end": 109.4,
      "speaker": "SPEAKER_01",
      "text": "para correr la fecha para el día 30 de agosto?",
      "rol": "AGENTE"
    },
    {
      "start": 109.66,
      "end": 110.74,
      "speaker": "SPEAKER_01",
      "text": "Sí, sí, sí, señora.",
      "rol": "DEUDOR"
    },
    {
      "start": 111.02,
      "end": 111.72,
      "speaker": "SPEAKER_01",
      "text": "Sí, señora.",
      "rol": "DEUDOR"
    },
    {
      "start": 112.64,
      "end": 113.64,
      "speaker": "SPEAKER_01",
      "text": "De acuerdo, señor.",
      "rol": "AGENTE"
    },
    {
      "start": 114.16,
      "end": 117.06,
      "speaker": "SPEAKER_01",
      "text": "Entonces vamos a correr la fecha para el día 30 de agosto",
      "rol": "AGENTE"
    },
    {
      "start": 117.06,
      "end": 119.32,
      "speaker": "SPEAKER_01",
      "text": "para que usted realice el pago a esta fecha",
      "rol": "AGENTE"
    },
    {
      "start": 119.32,
      "end": 122.92,
      "speaker": "SPEAKER_01",
      "text": "por 1.268.100 pesos",
      "rol": "AGENTE"
    },
    {
      "start": 122.92,
      "end": 125.3,
      "speaker": "SPEAKER_01",
      "text": "y dar cumplimiento a este acuerdo",
      "rol": "AGENTE"
    },
    {
      "start": 125.3,
      "end": 127.34,
      "speaker": "SPEAKER_01",
      "text": "para no anular su acuerdo de pago",
      "rol": "AGENTE"
    },
    {
      "start": 127.34,
      "end": 128.68,
      "speaker": "SPEAKER_01",
      "text": "y que no pierda beneficios.",
      "rol": "AGENTE"
    },
    {
      "start": 129.3,
      "end": 130.32,
      "speaker": "SPEAKER_01",
      "text": "Ok, vale.",
      "rol": "DEUDOR"
    },
    {
      "start": 131.58,
      "end": 132.2,
      "speaker": "SPEAKER_01",
      "text": "Perfecto, señor.",
      "rol": "AGENTE"
    },
    {
      "start": 132.56,
      "end": 134.64,
      "speaker": "SPEAKER_01",
      "text": "Algo fue enviado al acuerdo de pago.",
      "rol": "AGENTE"
    },
    {
      "start": 134.76,
      "end": 135.42,
      "speaker": "SPEAKER_01",
      "text": "¿Usted lo recibió?",
      "rol": "AGENTE"
    },
    {
      "start": 135.48,
      "end": 135.8,
      "speaker": "SPEAKER_01",
      "text": "Ajá.",
      "rol": "DEUDOR"
    },
    {
      "start": 135.8,
      "end": 137.12,
      "speaker": "SPEAKER_01",
      "text": "Sí, sí señorita",
      "rol": "DEUDOR"
    },
    {
      "start": 137.12,
      "end": 138.4,
      "speaker": "SPEAKER_01",
      "text": "Perfecto",
      "rol": "AGENTE"
    },
    {
      "start": 138.4,
      "end": 139.68,
      "speaker": "SPEAKER_01",
      "text": "Por medio de",
      "rol": "AGENTE"
    },
    {
      "start": 139.68,
      "end": 143.25,
      "speaker": "SPEAKER_01",
      "text": "Se debe realizar este pago el día 30 de",
      "rol": "AGENTE"
    },
    {
      "start": 143.25,
      "end": 145.41,
      "speaker": "SPEAKER_01",
      "text": "Agosto y enviamos el soporte",
      "rol": "AGENTE"
    },
    {
      "start": 145.41,
      "end": 146.97,
      "speaker": "SPEAKER_01",
      "text": "De pago para dar cumplimiento",
      "rol": "AGENTE"
    },
    {
      "start": 146.97,
      "end": 148.83,
      "speaker": "SPEAKER_01",
      "text": "Y no anular el acuerdo de pago",
      "rol": "AGENTE"
    },
    {
      "start": 148.83,
      "end": 149.95,
      "speaker": "SPEAKER_01",
      "text": "Que pida la venida",
      "rol": "AGENTE"
    },
    {
      "start": 149.95,
      "end": 152.77,
      "speaker": "SPEAKER_01",
      "text": "Bueno, sí señorita",
      "rol": "DEUDOR"
    },
    {
      "start": 152.77,
      "end": 153.87,
      "speaker": "SPEAKER_01",
      "text": "Perfecto",
      "rol": "AGENTE"
    },
    {
      "start": 153.87,
      "end": 156.03,
      "speaker": "SPEAKER_01",
      "text": "Recuerde que la abonariza",
      "rol": "AGENTE"
    },
    {
      "start": 156.03,
      "end": 157.91,
      "speaker": "SPEAKER_01",
      "text": "Y que tenga un excelente día",
      "rol": "AGENTE"
    },
    {
      "start": 157.91,
      "end": 159.57,
      "speaker": "SPEAKER_01",
      "text": "Bueno, muchas gracias",
      "rol": "DEUDOR"
    }

      "speaker": "SPEAKER_00",
      "text": "de lo que se le envolvió en ese momento?",
      "rol": "AGENTE"
    },
    {
      "start": 534.13,
      "end": 535.83,
      "speaker": "SPEAKER_01",
      "text": "Esa vez me mandaron un papelito,",
      "rol": "DEUDOR"
    },
    {
      "start": 535.99,
      "end": 537.13,
      "speaker": "SPEAKER_01",
      "text": "pero la verdad, la verdad,",
      "rol": "DEUDOR"
    },
    {
      "start": 537.23,
      "end": 539.87,
      "speaker": "SPEAKER_01",
      "text": "ni siquiera sé dónde lo dejé.",
      "rol": "DEUDOR"
    },
    {
      "start": 541.71,
      "end": 542.71,
      "speaker": "SPEAKER_00",
      "text": "Vamos con lo siguiente.",
      "rol": "AGENTE"
    },
    {
      "start": 544.65,
      "end": 545.61,
      "speaker": "SPEAKER_00",
      "text": "Yo le voy a escribir...",
      "rol": "AGENTE"
    },
    {
      "start": 546.67,
      "end": 548.07,
      "speaker": "SPEAKER_00",
      "text": "¿Tiene WhatsApp en esta línea?",
      "rol": "AGENTE"
    },
    {
      "start": 549.79,
      "end": 550.15,
      "speaker": "SPEAKER_00",
      "text": "Sí, señor.",
      "rol": "AGENTE"
    },
    {
      "start": 550.53,
      "end": 552.55,
      "speaker": "SPEAKER_00",
      "text": "Si llega a encontrar algún tipo de soporte,",
      "rol": "AGENTE"
    },
    {
      "start": 552.65,
      "end": 553.55,
      "speaker": "SPEAKER_00",
      "text": "algún tipo de evidencia,",
      "rol": "AGENTE"
    },
    {
      "start": 553.59,
      "end": 554.33,
      "speaker": "SPEAKER_00",
      "text": "me la puede enviar.",
      "rol": "AGENTE"
    },
    {
      "start": 554.45,
      "end": 555.77,
      "speaker": "SPEAKER_00",
      "text": "Yo con mucho gusto la puedo escalar.",
      "rol": "AGENTE"
    },
    {
      "start": 556.13,
      "end": 557.33,
      "speaker": "SPEAKER_00",
      "text": "Y de paso me voy a mirar",
      "rol": "AGENTE"
    },
    {
      "start": 557.33,
      "end": 560.41,
      "speaker": "SPEAKER_00",
      "text": "con nuestra área financiera",
      "rol": "AGENTE"
    },
    {
      "start": 560.41,
      "end": 562.67,
      "speaker": "SPEAKER_00",
      "text": "qué tipo de posibilidades o alternativas",
      "rol": "AGENTE"
    },
    {
      "start": 562.67,
      "end": 563.51,
      "speaker": "SPEAKER_00",
      "text": "le podemos brindar",
      "rol": "AGENTE"
    },
    {
      "start": 563.51,
      "end": 565.95,
      "speaker": "SPEAKER_00",
      "text": "para poder congelar primero los intereses",
      "rol": "AGENTE"
    },
    {
      "start": 565.95,
      "end": 566.99,
      "speaker": "SPEAKER_00",
      "text": "que no sigan subiendo",
      "rol": "AGENTE"
    },
    {
      "start": 566.99,
      "end": 569.21,
      "speaker": "SPEAKER_00",
      "text": "y poder brindarle un alivio financiero",
      "rol": "AGENTE"
    },
    {
      "start": 569.21,
      "end": 571.27,
      "speaker": "SPEAKER_00",
      "text": "cosa de que pueda ofrecerse a la empresa",
      "rol": "AGENTE"
    },
    {
      "start": 571.27,
      "end": 573.49,
      "speaker": "SPEAKER_00",
      "text": "pero también necesito por favor",
      "rol": "AGENTE"
    },
    {
      "start": 573.49,
      "end": 574.55,
      "speaker": "SPEAKER_00",
      "text": "que su merced verifique",
      "rol": "AGENTE"
    },
    {
      "start": 574.55,
      "end": 576.11,
      "speaker": "SPEAKER_00",
      "text": "si tiene algún documento o algo",
      "rol": "AGENTE"
    },
    {
      "start": 576.11,
      "end": 577.45,
      "speaker": "SPEAKER_00",
      "text": "de que está debilitado",
      "rol": "AGENTE"
    },
    {
      "start": 577.45,
      "end": 581.51,
      "speaker": "SPEAKER_00",
      "text": "600 mil pesos",
      "rol": "AGENTE"
    },
    {
      "start": 581.51,
      "end": 582.65,
      "speaker": "SPEAKER_00",
      "text": "que me indica usted",
      "rol": "AGENTE"
    },
    {
      "start": 582.65,
      "end": 585.75,
      "speaker": "SPEAKER_01",
      "text": "Sí señor, yo los cancelé",
      "rol": "DEUDOR"
    },
    {
      "start": 585.75,
      "end": 591.48,
      "speaker": "SPEAKER_00",
      "text": "Sí señora, no, cuando usted me indica",
      "rol": "AGENTE"
    },
    {
      "start": 591.48,
      "end": 593.34,
      "speaker": "SPEAKER_00",
      "text": "que lo único que usted debía",
      "rol": "AGENTE"
    },
    {
      "start": 593.34,
      "end": 594.86,
      "speaker": "SPEAKER_00",
      "text": "o lo único capital que le",
      "rol": "AGENTE"
    },
    {
      "start": 594.86,
      "end": 596.7,
      "speaker": "SPEAKER_00",
      "text": "quedó pendiente, fueron",
      "rol": "AGENTE"
    },
    {
      "start": 596.7,
      "end": 599.22,
      "speaker": "SPEAKER_00",
      "text": "trescientos y pico veinte pesos",
      "rol": "AGENTE"
    },
    {
      "start": 599.22,
      "end": 600.52,
      "speaker": "SPEAKER_00",
      "text": "Sí",
      "rol": "AGENTE"
    },
    {
      "start": 600.52,
      "end": 602.86,
      "speaker": "SPEAKER_00",
      "text": "Sí señora, entonces si de pronto",
      "rol": "AGENTE"
    },
    {
      "start": 602.86,
      "end": 604.26,
      "speaker": "SPEAKER_00",
      "text": "vamos a iniciar la conversación",
      "rol": "AGENTE"
    },
    {
      "start": 604.26,
      "end": 606.32,
      "speaker": "SPEAKER_00",
      "text": "y espérense que",
      "rol": "AGENTE"
    },
    {
      "start": 606.32,
      "end": 609.46,
      "speaker": "SPEAKER_00",
      "text": "si no, yo le voy a enviar",
      "rol": "AGENTE"
    },
    {
      "start": 609.46,
      "end": 610.94,
      "speaker": "SPEAKER_00",
      "text": "todas las propuestas y miramos a ver",
      "rol": "AGENTE"
    },
    {
      "start": 610.94,
      "end": 613.1,
      "speaker": "SPEAKER_00",
      "text": "qué podemos acertar y cosas",
      "rol": "AGENTE"
    },
    {
      "start": 613.1,
      "end": 615.16,
      "speaker": "SPEAKER_00",
      "text": "que evitemos todo este tema engorroso, ¿bueno?",
      "rol": "AGENTE"
    },
    {
      "start": 616.52,
      "end": 618.16,
      "speaker": "SPEAKER_01",
      "text": "Sí, señor, porque es que, o sea,",
      "rol": "DEUDOR"
    },
    {
      "start": 618.58,
      "end": 620.2,
      "speaker": "SPEAKER_01",
      "text": "créame que en ningún banco,",
      "rol": "DEUDOR"
    },
    {
      "start": 620.36,
      "end": 622.36,
      "speaker": "SPEAKER_01",
      "text": "en ninguna entidad, están",
      "rol": "DEUDOR"
    },
    {
      "start": 622.36,
      "end": 624.32,
      "speaker": "SPEAKER_01",
      "text": "cobrando así, como, como,",
      "rol": "DEUDOR"
    },
    {
      "start": 624.42,
      "end": 626.42,
      "speaker": "SPEAKER_01",
      "text": "como, como, como allá,",
      "rol": "DEUDOR"
    },
    {
      "start": 626.56,
      "end": 627.78,
      "speaker": "SPEAKER_01",
      "text": "allá en el...",
      "rol": "DEUDOR"
    },
    {
      "start": 627.78,
      "end": 631.88,
      "speaker": "SPEAKER_00",
      "text": "No, y el propósito nuestro siempre va a ser",
      "rol": "AGENTE"
    },
    {
      "start": 631.88,
      "end": 633.76,
      "speaker": "SPEAKER_00",
      "text": "poder ayudar a las personas. Pues así",
      "rol": "AGENTE"
    },
    {
      "start": 633.76,
      "end": 635.76,
      "speaker": "SPEAKER_00",
      "text": "quedaríamos, mis... Le agradezco mucho su",
      "rol": "AGENTE"
    },
    {
      "start": 635.76,
      "end": 637.26,
      "speaker": "SPEAKER_00",
      "text": "tiempo, que pase buen día. Hasta luego.",
      "rol": "AGENTE"
    },
    {
      "start": 638.84,
      "end": 639.56,
      "speaker": "SPEAKER_00",
      "text": "Bueno, sí, señor.",
      "rol": "AGENTE"
    }

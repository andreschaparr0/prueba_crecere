  "segments": [
    {
      "start": 5.49,
      "end": 6.79,
      "speaker": "SPEAKER_01",
      "text": "Aló, buenas tardes.",
      "rol": "AGENTE"
    },
    {
      "start": 7.49,
      "end": 8.85,
      "speaker": "SPEAKER_01",
      "text": "Por favor, se me...",
      "rol": "AGENTE"
    },
    {
      "start": 8.85,
      "end": 11.42,
      "speaker": "SPEAKER_01",
      "text": "Sí, con ella.",
      "rol": "AGENTE"
    },
    {
      "start": 12.48,
      "end": 15.94,
      "speaker": "SPEAKER_01",
      "text": "¿Cómo está? Le está hablando Daniela. Me estoy comunicando de solución...",
      "rol": "AGENTE"
    },
    {
      "start": 15.94,
      "end": 20.9,
      "speaker": "SPEAKER_01",
      "text": "El tema de un compromiso de pago que se tenía para el 30 de junio por 300 mil pesos.",
      "rol": "AGENTE"
    },
    {
      "start": 21.12,
      "end": 25.2,
      "speaker": "SPEAKER_01",
      "text": "Es que el pago no me registró en el sistema. Quisiera confirmar con su mujer si pudo realizar el pago.",
      "rol": "AGENTE"
    },
    {
      "start": 25.86,
      "end": 31.66,
      "speaker": "SPEAKER_01",
      "text": "Sí, señora. Lo que pasa es que no, no, no pude hacer el pago porque se me presentó una calamidad.",
      "rol": "AGENTE"
    },
    {
      "start": 31.98,
      "end": 32.98,
      "speaker": "SPEAKER_00",
      "text": "Entonces, no pude.",
      "rol": "DEUDOR"
    },
    {
      "start": 34.59,
      "end": 35.29,
      "speaker": "SPEAKER_01",
      "text": "Comprendo, señora.",
      "rol": "AGENTE"
    },
    {
      "start": 35.29,
      "end": 35.69,
      "speaker": "SPEAKER_01",
      "text": "Buenas.",
      "rol": "AGENTE"
    },
    {
      "start": 35.69,
      "end": 39.13,
      "speaker": "SPEAKER_01",
      "text": "Entonces, en este caso, ¿cuándo realizaríamos el pago?",
      "rol": "AGENTE"
    },
    {
      "start": 39.75,
      "end": 45.79,
      "speaker": "SPEAKER_01",
      "text": "Pues yo lo tengo programado para realizarlo el 15, pues porque como me pagan 15 en algo, por eso.",
      "rol": "AGENTE"
    },
    {
      "start": 47.34,
      "end": 49.46,
      "speaker": "SPEAKER_01",
      "text": "Para el 15 de julio, ¿correcto?",
      "rol": "AGENTE"
    },
    {
      "start": 49.64,
      "end": 50.4,
      "speaker": "SPEAKER_01",
      "text": "Sí, señora.",
      "rol": "AGENTE"
    },
    {
      "start": 52.02,
      "end": 52.42,
      "speaker": "SPEAKER_01",
      "text": "Perfecto.",
      "rol": "AGENTE"
    },
    {
      "start": 52.84,
      "end": 55.16,
      "speaker": "SPEAKER_01",
      "text": "Pues vamos a dejar acá la notación en el sistema.",
      "rol": "AGENTE"
    },
    {
      "start": 55.76,
      "end": 58.34,
      "speaker": "SPEAKER_01",
      "text": "Quisiera confirmar con su vecina y en el presidente de los medios de pago.",
      "rol": "AGENTE"
    },
    {
      "start": 58.46,
      "end": 60.28,
      "speaker": "SPEAKER_01",
      "text": "¿Gustaría que le envíe la información de los mismos?",
      "rol": "AGENTE"
    },
    {
      "start": 61.14,
      "end": 63.62,
      "speaker": "SPEAKER_01",
      "text": "Sí, señora. Sí, me lo puede enviar, por favor.",
      "rol": "AGENTE"
    },
    {
      "start": 64.42,
      "end": 65.3,
      "speaker": "SPEAKER_01",
      "text": "Listo. ¿Este mismo número?",
      "rol": "AGENTE"
    },
    {
      "start": 65.3,
      "end": 67.23,
      "speaker": "SPEAKER_01",
      "text": "Sí, sí, señora",
      "rol": "AGENTE"
    },
    {
      "start": 67.23,
      "end": 68.43,
      "speaker": "SPEAKER_01",
      "text": "Perfecto, señora",
      "rol": "AGENTE"
    },
    {
      "start": 68.43,
      "end": 70.31,
      "speaker": "SPEAKER_01",
      "text": "Entonces, quedo atenta al envío del comprobante",
      "rol": "AGENTE"
    },
    {
      "start": 70.31,
      "end": 72.05,
      "speaker": "SPEAKER_01",
      "text": "y le agradezco por haber atendido mi llamada",
      "rol": "AGENTE"
    },
    {
      "start": 72.05,
      "end": 74.25,
      "speaker": "SPEAKER_01",
      "text": "Bueno, sí, señora, muchas gracias",
      "rol": "AGENTE"
    },

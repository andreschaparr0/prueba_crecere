  "segments": [
    {
      "start": 0.37,
      "end": 14.08,
      "speaker": "SPEAKER_01",
      "text": "Hola, buen día. Habla con el señor Vallejo del área de embargos, judicializaciones y",
      "rol": "AGENTE"
    },
    {
      "start": 14.08,
      "end": 23.56,
      "speaker": "SPEAKER_00",
      "text": "alivios financieros. Le llamo por su obligación. ¿Cómo me le va? Bien, gracias a Dios. Le",
      "rol": "DEUDOR"

    },
    {
      "start": 62.08,
      "end": 77.14,
      "speaker": "SPEAKER_00",
      "text": "Lo que tengo es que se trata de una obligación",
      "rol": "DEUDOR"
    },
    {
      "start": 77.14,
      "end": 79.62,
      "speaker": "SPEAKER_01",
      "text": "originada en 2021.",
      "rol": "AGENTE"
    },
    {
      "start": 80.12,
      "end": 81.88,
      "speaker": "SPEAKER_01",
      "text": "¿Tiene alguna otra duda sobre la deuda",
      "rol": "AGENTE"
    },
    {
      "start": 81.88,
      "end": 83.88,
      "speaker": "SPEAKER_01",
      "text": "o me permite comentarle la propuesta de acuerdo",
      "rol": "AGENTE"
    },
    {
      "start": 83.88,
      "end": 84.9,

      "start": 123.91,
      "end": 124.29,
      "speaker": "SPEAKER_01",
      "text": "Excelente.",
      "rol": "AGENTE"
    },
    {
      "start": 125.07,
      "end": 128.61,
      "speaker": "SPEAKER_01",
      "text": "Queremos ofrecerle un descuento del 19% de toda la deuda.",
      "rol": "AGENTE"
    },
    {
      "start": 129.01,
      "end": 131.63,
      "speaker": "SPEAKER_01",
      "text": "Así le condonaríamos un total de 490 mil pesos.",
      "rol": "AGENTE"
    },
    {
      "start": 131.63,
      "end": 138.33,
      "speaker": "SPEAKER_01",
      "text": "Con el descuento ya no debería 2.600.000 pesos, sino solo 2.110.000 pesos.",
      "rol": "AGENTE"
    },
    {
      "start": 138.73,
      "end": 141.29,
      "speaker": "SPEAKER_01",
      "text": "Además, le puedo dejar que pague hasta en una cuota.",
      "rol": "AGENTE"
    },
    {
      "start": 141.77,
      "end": 146.57,
      "speaker": "SPEAKER_01",
      "text": "Así serían unas pagos mensuales de 2.110.000 pesos cada uno.",
      "rol": "AGENTE"
    },
    {
      "start": 147.01,
      "end": 150.36,
      "speaker": "SPEAKER_01",
      "text": "Es una propuesta por tiempo limitado que vencería hoy mismo.",

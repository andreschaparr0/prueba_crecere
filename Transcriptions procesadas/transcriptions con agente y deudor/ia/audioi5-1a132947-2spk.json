      "rol": "AGENTE"
    },
    {
      "start": 99.76,
      "end": 103.04,
      "speaker": "SPEAKER_01",
      "text": "Lo importante es que hoy tenemos una propuesta para resolver esta obligación.",
      "rol": "AGENTE"
    },
    {
      "start": 103.5,
      "end": 105.58,
      "speaker": "SPEAKER_01",
      "text": "¿Me permite comentarle el acuerdo que podemos ofrecerle?",
      "rol": "AGENTE"
    },
    {
      "start": 106.22,
      "end": 110.24,
      "speaker": "SPEAKER_00",
      "text": "Sí, señor. Dígame, porque eso me tiene como preocupado.",

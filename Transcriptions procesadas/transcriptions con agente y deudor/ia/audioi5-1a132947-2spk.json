    },
    {
      "start": 150.76,
      "end": 155.54,
      "speaker": "SPEAKER_01",
      "text": "Me puede indicar con un sí o un no si le interesa este descuento y hacemos este acuerdo de pago.",
      "rol": "AGENTE"
    },
    {
      "start": 156.26,
      "end": 158.28,
      "speaker": "SPEAKER_00",
      "text": "Tengo que darle 2 millones, ¿qué dijo?",
      "rol": "DEUDOR"
    },
    {
      "start": 158.28,
      "end": 164.76,
      "speaker": "SPEAKER_00",
      "text": "Ahí no le entendí lo que me dijo ahí",
      "rol": "DEUDOR"
    },
    {
      "start": 164.76,
      "end": 167.77,
      "speaker": "SPEAKER_00",
      "text": "¿Aló?",
      "rol": "DEUDOR"
    },

      "start": 171.46,
      "end": 172.8,
      "speaker": "SPEAKER_01",
      "text": "Sí, se escuchó",
      "rol": "AGENTE"
    },
    {
      "start": 172.8,
      "end": 174.24,
      "speaker": "SPEAKER_00",
      "text": "¿Le explico en una sola cuota?",
      "rol": "DEUDOR"
    },
    {
      "start": 175.41,
      "end": 176.55,
      "speaker": "SPEAKER_00",
      "text": "Sí, una...",

      "text": "Dígame.",
      "rol": "DEUDOR"
    },
    {
      "start": 53.3,
      "end": 60.5,
      "speaker": "SPEAKER_01",
      "text": "La obligación se originó el 24 de octubre de 2021 por un monto inicial de 1.330.000 pesos.",

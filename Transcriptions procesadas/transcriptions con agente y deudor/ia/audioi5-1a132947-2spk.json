    },
    {
      "start": 112.42,
      "end": 112.9,
      "speaker": "SPEAKER_01",
      "text": "Le entiendo.",
      "rol": "AGENTE"
    },
    {
      "start": 113.56,
      "end": 117.14,
      "speaker": "SPEAKER_01",
      "text": "Mire, tenemos hoy una propuesta especial con un descuento considerable sobre la deuda.",

  "segments": [
    {
      "start": 0.0,
      "end": 8.51,
      "speaker": "SPEAKER_00",
      "text": "Aló, muy buenos días",
      "rol": "AGENTE"
    },
    {
      "start": 8.51,
      "end": 10.97,
      "speaker": "SPEAKER_01",
      "text": "Muy buenos días",
      "rol": "DEUDOR"
    },
    {
      "start": 10.97,
      "end": 16.19,
      "speaker": "SPEAKER_00",
      "text": "¿Podría confirmarme si estoy hablando con...",
      "rol": "AGENTE"
    },
    {
      "start": 16.19,
      "end": 19.52,
      "speaker": "SPEAKER_01",
      "text": "Sí, con ella",
      "rol": "DEUDOR"
    },
    {
      "start": 19.52,
      "end": 24.68,
      "speaker": "SPEAKER_01",
      "text": "Aló",
      "rol": "DEUDOR"
    },
    {
      "start": 24.68,
      "end": 35.02,
      "speaker": "SPEAKER_00",
      "text": "...le habló del área de embargos, judicializaciones y alivios financieros",
      "rol": "AGENTE"
    },
    {
      "start": 35.56,
      "end": 36.56,
      "speaker": "SPEAKER_00",
      "text": "Le llamo por su obligación.",
      "rol": "AGENTE"
    },
    {
      "start": 37.72,
      "end": 38.68,
      "speaker": "SPEAKER_00",
      "text": "¿Cómo se encuentra?",
      "rol": "AGENTE"
    },
    {
      "start": 43.08,
      "end": 57.02,
      "speaker": "SPEAKER_00",
      "text": "Le cuento que muchas personas en una situación parecida a la suya ya lograron ponerse al día y seguir tranquilas.",
      "rol": "AGENTE"
    },
    {
      "start": 57.18,
      "end": 58.48,
      "speaker": "SPEAKER_00",
      "text": "Me gustaría que usted también pueda.",
      "rol": "AGENTE"
    },
    {
      "start": 59.2,
      "end": 61.22,
      "speaker": "SPEAKER_00",
      "text": "¿Le puedo contar en un momento de qué se trata?",
      "rol": "AGENTE"
    },
    {
      "start": 63.52,
      "end": 65.2,
      "speaker": "SPEAKER_01",
      "text": "No, señorita, no tengo tiempo.",
      "rol": "DEUDOR"
    },
    {
      "start": 69.89,
      "end": 71.17,
      "speaker": "SPEAKER_00",
      "text": "Gracias por confirmarlo.",
      "rol": "AGENTE"
    },
    {
      "start": 71.49,
      "end": 74.33,
      "speaker": "SPEAKER_00",
      "text": "Como ya lo han hecho muchos clientes en su misma situación,",
      "rol": "AGENTE"
    },
    {
      "start": 74.33,
      "end": 77.47,
      "speaker": "SPEAKER_00",
      "text": "Regularizar esta obligación hoy es más sencillo de lo que parece",
      "rol": "AGENTE"
    },
    {
      "start": 77.47,
      "end": 81.93,
      "speaker": "SPEAKER_00",
      "text": "Por este motivo queremos poder ofrecerle alternativas para ponerse al día con su deuda",
      "rol": "AGENTE"
    },
    {
      "start": 81.93,
      "end": 82.65,
      "speaker": "SPEAKER_00",
      "text": "¿Le interesa?",
      "rol": "AGENTE"
    },
    {
      "start": 84.24,
      "end": 84.78,
      "speaker": "SPEAKER_01",
      "text": "Que no",
      "rol": "DEUDOR"
    },
    {
      "start": 84.78,
      "end": 88.62,
      "speaker": "SPEAKER_00",
      "text": "Entiendo que esta situación no sea agradable",
      "rol": "AGENTE"
    },
    {
      "start": 88.62,
      "end": 90.44,
      "speaker": "SPEAKER_00",
      "text": "Lo entiendo, y es más",
      "rol": "AGENTE"
    },
    {
      "start": 90.44,
      "end": 95.28,
      "speaker": "SPEAKER_00",
      "text": "Precisamente por eso la llamamos",
      "rol": "AGENTE"
    },
    {
      "start": 95.28,
      "end": 97.8,
      "speaker": "SPEAKER_00",
      "text": "Porque tenemos una propuesta con un descuento importante",
      "rol": "AGENTE"
    },
    {
      "start": 97.8,
      "end": 100.48,
      "speaker": "SPEAKER_00",
      "text": "Para que pueda resolver esto de la manera más cómoda posible",
      "rol": "AGENTE"
    },
    {
      "start": 100.48,
      "end": 101.6,
      "speaker": "SPEAKER_00",
      "text": "Le doy los detalles",
      "rol": "AGENTE"
    }
  ],
